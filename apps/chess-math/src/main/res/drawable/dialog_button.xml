<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E6046" />
            <stroke android:width="2.5dp" android:color="#FFCF70" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E6046" />
            <stroke android:width="2.5dp" android:color="#FFCF70" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C492E" />
            <stroke android:width="1dp" android:color="#B5CEB0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
