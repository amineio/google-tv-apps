<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#0C2B1D</item>
        <item name="android:colorAccent">#6BE0BD</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/ThemeOverlay.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">#0C2B1D</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowMinWidthMajor">60%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:textColorPrimary">#FFF1D0</item>
        <item name="android:textColorSecondary">#B5CEB0</item>
        <item name="android:colorAccent">#FFCF70</item>
        <item name="android:colorControlActivated">#FFCF70</item>
        <item name="android:colorControlHighlight">#3E6046</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
        <item name="android:textAppearanceMedium">@style/DialogBody</item>
        <item name="android:textAppearanceLarge">@style/DialogBody</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogButton</item>
    </style>
    <style name="DialogTitle" parent="android:style/Widget.Material.TextView">
        <item name="android:textColor">#FFF1D0</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="DialogBody" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">#FFF1D0</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="DialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_button</item>
        <item name="android:textColor">#FFF1D0</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
